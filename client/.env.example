# ─────────────────────────────────────────────────────────────
# Cloudflare Pages Environment Variables (Build & Runtime)
# Add these in Cloudflare Pages Dashboard -> Settings -> Environment Variables
# ─────────────────────────────────────────────────────────────

# Backend Render API URL (Without trailing slash)
VITE_BASE_URL=https://your-backend-app.onrender.com

# Supabase Auth & Database (Public Anon Key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay Client ID (Optional, for payments)
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id
