# ─────────────────────────────────────────────────────────────
# Render Web Service Environment Variables
# Add these in Render Dashboard -> Environment -> Environment Variables
# ─────────────────────────────────────────────────────────────

PORT=3000

# Supabase (Database, Auth, Admin Role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq AI Engine (Required for ultra-fast text, code, summary, ATS review)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=groq/compound

# Google Gemini (Optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Pollinations AI Key (Free multi-model Image generator)
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Cloudinary (Image cleanup, photo uploads, storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Configuration
ADMIN_EMAILS=admin@gmail.com
VIP_PROMO_CODE=VISIONARY2026

# Stripe Payment Gateway (Optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=dummy_secret
STRIPE_SUCCESS_URL=https://your-frontend.pages.dev/ai?payment=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://your-frontend.pages.dev/#pro-plan?payment=cancelled

# Razorpay Payment Gateway (Optional)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
